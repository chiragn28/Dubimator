# Dubimator Streamlit demo (Phase 8). It talks to the API over HTTP only, so it needs just
# streamlit, httpx and python-dotenv (versions match uv.lock).
FROM python:3.11-slim

RUN pip install --no-cache-dir \
        "streamlit==1.64.0" \
        "httpx==0.28.1" \
        "python-dotenv==1.2.3" \
    && groupadd --system app \
    && useradd --system --gid app --create-home --home-dir /home/app app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false \
    STREAMLIT_CLIENT_SHOW_ERROR_DETAILS=false
WORKDIR /app
# Streamlit reads .streamlit/config.toml relative to the working directory, so the demo's
# palette has to travel with it or the container falls back to Streamlit's default theme.
COPY .streamlit ./.streamlit
COPY demo ./demo
USER app
EXPOSE 8501
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=4)"]
CMD ["python", "-m", "streamlit", "run", "demo/app.py", "--server.port", "8501", "--server.address", "0.0.0.0", "--server.headless", "true"]
