POSTGRES_USER=zestimator
POSTGRES_PASSWORD=changeme
POSTGRES_DB=zestimator
# Change POSTGRES_PORT if a local Postgres already uses 5432 (e.g. 5433)
POSTGRES_PORT=5432
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://127.0.0.1:${MLFLOW_PORT}
AIRFLOW_PORT=8080

# Phase 7 API (comma-separated keys; generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
API_KEYS=
API_RATE_LIMIT_PER_MINUTE=60
API_CORS_ORIGINS=
# Keys (each also listed in API_KEYS) allowed to call POST /v1/admin/reload; blank disables reload
API_ADMIN_KEYS=
# Components to load (comma-separated; blank = all): price,forecast,search,listings,areas
API_COMPONENTS=
# Device for the shared text embedder: auto, cpu or cuda
API_EMBED_DEVICE=auto

# Phase 8 demo: one of API_KEYS (held server-side by the demo; compose sets DEMO_API_URL)
DEMO_API_KEY=

# Phase 10 deploy and monitor (docker compose); host ports bind to 127.0.0.1 only
API_PORT=8000
DEMO_PORT=8501
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# Required for --profile monitoring (Grafana refuses to start without it)
GRAFANA_ADMIN_PASSWORD=
# Optional: a named Cloudflare Tunnel token (--profile tunnel-named); blank = quick tunnel only
CLOUDFLARE_TUNNEL_TOKEN=
